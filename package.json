{
  "name": "ceec-data-explorer-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "data:sync": "node scripts/sync-data.mjs",
    "dev": "npm run data:sync && next dev",
    "build": "npm run data:sync && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests-web/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "data": "python -m ceec_etl all && npm run data:sync"
  },
  "dependencies": {
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^7.0.2"
  }
}
